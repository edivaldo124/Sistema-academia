# Configurações do Flask
SECRET_KEY=chave_secreta_academia_desenvolvimento
COOKIE_SECURE=false

# Banco de Dados Supabase (Settings > Database > Connection string)
# Use a URL do pooler em Session mode para aplicações Flask persistentes.
# Se a senha tiver caracteres especiais, copie a URI fornecida pelo painel
# com a senha corretamente codificada na URL.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Configurações de E-mail
# OPÇÃO 1 (Recomendada para Render Gratuito - usa HTTPS na porta 443):
# Cadastre-se grátis em https://www.brevo.com e gere uma chave de API em SMTP & API -> API Keys
BREVO_API_KEY=
# Ou via Resend (https://resend.com):
RESEND_API_KEY=

# OPÇÃO 2 (Local ou Render Pago - Gmail via SMTP):
EMAIL_REMETENTE=seu_email@gmail.com
EMAIL_SENHA=sua_senha_de_aplicativo_aqui
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

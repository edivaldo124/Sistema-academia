# Copie este arquivo para .env e preencha apenas no seu computador.
# Nunca envie o arquivo .env para o GitHub.

SECRET_KEY=gere-uma-chave-secreta-longa-e-aleatoria
APP_BASE_URL=http://localhost:5000

# Banco local (ajuste de acordo com o seu PostgreSQL)
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost/academia3_db

# Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=senha_de_aplicativo_sem_espacos
MAIL_DEFAULT_SENDER=seu_email@gmail.com
MAIL_SENDER_NAME=Academia
MAIL_TIMEOUT=10

# Link de recuperação válido por 30 minutos
RESET_TOKEN_MAX_AGE=1800
